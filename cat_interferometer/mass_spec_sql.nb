         "\[Gamma]0", ",", "f", ",", "tTick", ",", "tCat", ",", " ", 
          "\[Alpha]"}], "]"}], ",", " ", "eps"}], "]"}]], "+", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"D", "[", 
