    SuperscriptBox[
     RowBox[{"Cos", "[", 
      RowBox[{"2", "*", 
       RowBox[{"\[Gamma]", "[", 
        RowBox[{"\[Gamma]0", ",", "f", ",", "tTick"}], "]"}], "*", "\[Alpha]",
        "*", 
       RowBox[{"Sin", "[", 
