         "\[Alpha]"}], "]"}], ",", " ", "eps"}], "]"}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FFEnt", " ", "=", 
    RowBox[{
     RowBox[{"FEnt", "[", 
