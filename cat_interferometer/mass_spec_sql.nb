Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Fisher", " ", "information", " ", "gain", " ", "from", " ", "cat", " ", 
    "unterferometer", " ", "versus", " ", "ramsey"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"fisherInfoCat", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{
        "\[Gamma]0", ",", "f", ",", "tTick", ",", "tCat", ",", "\[Alpha]"}], 
        "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"tTick", "->", "tTickleUse"}], ",", " ", 
         RowBox[{"\[Gamma]0", "->", "\[Gamma]0Use"}], ",", " ", 
         RowBox[{"f", "->", "fCatopt"}], ",", " ", 
         RowBox[{"\[Alpha]", "->", "\[Alpha]Use"}], ",", " ", 
         RowBox[{"tCat", "->", "tCatUse"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"fisherInfoCat", "/", 
    SuperscriptBox["10", 
     RowBox[{"-", "5"}]]}], "\n", 
   RowBox[{"fisherInfoRamsey", " ", "=", " ", 
    RowBox[{"Limit", "[", 
     RowBox[{"FFRamsey", ",", " ", 
      RowBox[{"f", "->", "0"}]}], "]"}]}], "\n", "\n", 
   RowBox[{
    RowBox[{"fisherInfoRatioCatRamsey", " ", "=", " ", 
     FractionBox["fisherInfoCat", "fisherInfoRamsey"]}], ";"}], "\n", 
   RowBox[{"N", "[", 
    RowBox[{"10", 
     RowBox[{"Log10", "[", "fisherInfoRatioCatRamsey", "]"}]}], 
