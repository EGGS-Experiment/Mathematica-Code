     "4"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", 
     RowBox[{"g_", ",", "f_", ",", "tTick_", ",", "tCat_", ",", "\[Alpha]_"}],
      "]"}], ":=", " ", 
    RowBox[{
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"pbb", "[", 
           RowBox[{
           "\[Gamma]0", ",", "f", ",", "tTick", ",", "tCat", ",", " ", 
            "\[Alpha]"}], "]"}], ",", " ", "f"}], "]"}], ")"}], "2"], 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"pbb", "[", 
