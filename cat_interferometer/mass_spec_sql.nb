 RowBox[{
  RowBox[{
   RowBox[{"pbb", "[", 
    RowBox[{
    "\[Gamma]0_", ",", "f_", ",", "tTick_", ",", "tCat_", ",", "\[Alpha]_"}], 
    "]"}], ":=", " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", 
     RowBox[{"2", "*", 
      RowBox[{"\[Gamma]", "[", 
       RowBox[{"\[Gamma]0", ",", " ", "f", ",", " ", "tTick"}], "]"}], "*", 
      "\[Alpha]", "*", 
      RowBox[{"Sin", "[", 
       RowBox[{
        FractionBox["\[Pi]", "2"], "+", 
        RowBox[{"2", "*", "\[Pi]", "*", "f", "*", 
         RowBox[{"(", 
          RowBox[{"tTick", "+", "tCat"}], ")"}]}]}], "]"}]}], "]"}], "4"]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pdd", "[", 
