          RowBox[{"tTick", "+", "tCat"}], ")"}]}]}], "]"}]}], "]"}], "4"]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pud", "[", 
    RowBox[{
    "\[Gamma]0_", ",", "f_", ",", "tTick_", ",", "tCat_", ",", "\[Alpha]_"}], 
    "]"}], ":=", " ", 
   RowBox[{"1", "-", 
    SuperscriptBox[
     RowBox[{"Sin", "[", 
      RowBox[{"2", "*", 
       RowBox[{"\[Gamma]", "[", 
        RowBox[{"\[Gamma]0", ",", "f", ",", "tTick"}], "]"}], "*", "\[Alpha]",
        "*", 
