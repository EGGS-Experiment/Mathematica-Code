       "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", "Bounds", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"CRBoundEnt", " ", "=", " ", 
   FractionBox["1", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"numExperiments", "*", 
       RowBox[{"FEnt", "[", 
