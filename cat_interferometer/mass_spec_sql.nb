Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eps", " ", "=", " ", 
    SuperscriptBox["10", 
     RowBox[{"-", "15"}]]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Entangled", " ", "Cat", " ", "Interferometer", " ", "Populations"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pbbEnt", "[", 
    RowBox[{
    "\[Gamma]0_", ",", "f_", ",", "tTick_", ",", "tCat_", ",", "\[Alpha]_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     RowBox[{"Cos", "[", 
      RowBox[{"4", "*", 
       RowBox[{"\[Gamma]", "[", 
        RowBox[{"\[Gamma]0", ",", " ", "f", ",", " ", "tTick"}], "]"}], "*", 
       "\[Alpha]", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox["\[Pi]", "2"], "+", 
         RowBox[{"2", "*", "\[Pi]", "*", "f", "*", 
          RowBox[{"(", 
           RowBox[{"tTick", "+", "tCat"}], ")"}]}]}], "]"}]}], "]"}], 
     "2"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pddEnt", "[", 
    RowBox[{
    "\[Gamma]0_", ",", "f_", ",", "tTick_", ",", "tCat_", ",", "\[Alpha]_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    FractionBox["1", "2"], 
    SuperscriptBox[
     RowBox[{"Cos", "[", 
      RowBox[{"4", "*", 
       RowBox[{"\[Gamma]", "[", 
        RowBox[{"\[Gamma]0", ",", " ", "f", ",", " ", "tTick"}], "]"}], "*", 
       "\[Alpha]", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox["\[Pi]", "2"], "+", 
         RowBox[{"2", "*", "\[Pi]", "*", "f", "*", 
          RowBox[{"(", 
           RowBox[{"tTick", "+", "tCat"}], ")"}]}]}], "]"}]}], "]"}], 
     "2"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pdbEnt", "[", 
     RowBox[{
     "\[Gamma]0_", ",", "f_", ",", "tTick_", ",", "tCat_", ",", "\[Alpha]_"}],
      "]"}], ":=", " ", 
    SuperscriptBox[
     RowBox[{"Sin", "[", 
      RowBox[{"4", "*", 
       RowBox[{"\[Gamma]", "[", 
        RowBox[{"\[Gamma]0", ",", " ", "f", ",", " ", "tCat"}], "]"}], "*", 
       "\[Alpha]", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{
         FractionBox["\[Pi]", "2"], "+", 
         RowBox[{"2", "*", "\[Pi]", "*", "f", "*", 
          RowBox[{"(", 
           RowBox[{"tCat", "+", "tTick"}], ")"}]}]}], "]"}]}], "]"}], "2"]}], 
   ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Entangled", " ", "Fisher", " ", "Info"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FEnt", "[", 
    RowBox[{
    "\[Gamma]0_", ",", "f_", ",", "tTick_", ",", "tCat_", ",", "\[Alpha]_"}], 
    "]"}], ":=", " ", 
   RowBox[{
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"pbbEnt", "[", 
          RowBox[{
          "\[Gamma]0", ",", "f", ",", "tTick", ",", "tCat", ",", " ", 
           "\[Alpha]"}], "]"}], ",", " ", "f"}], "]"}], ")"}], "2"], 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{"pbbEnt", "[", 
        RowBox[{
        "\[Gamma]0", ",", "f", ",", "tTick", ",", "tCat", ",", " ", 
         "\[Alpha]"}], "]"}], ",", " ", "eps"}], "]"}]], "+", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"pddEnt", "[", 
          RowBox[{
          "\[Gamma]0", ",", "f", ",", "tTick", ",", "tCat", ",", " ", 
           "\[Alpha]"}], "]"}], ",", " ", "f"}], "]"}], ")"}], "2"], 
     RowBox[{"Max", "[", 
