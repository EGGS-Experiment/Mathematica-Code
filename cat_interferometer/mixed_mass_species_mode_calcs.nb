    RowBox[{"actualData", " ", "=", " ", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"actualVoltageList", ",", " ", "resetSecFreqHz"}], "}"}]}]}], 
    ";"}], "\n", 
