                " ", 
               RowBox[{"{", 
                RowBox[{"n", ",", " ", "0", ",", " ", 
                 RowBox[{
                  RowBox[{"Length", "[", "pseudoCoeffs", "]"}], "-", "2"}]}], 
                "}"}]}], "]"}], ")"}], "2"]}], 
          RowBox[{"4", "*", 
           RowBox[{"massArr", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", "amu", "*", 
           SuperscriptBox["\[CapitalOmega]RF", "2"]}]], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], "]"}]}],
       ";"}], "\n", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "add", " ", "and", " ", "return", " ", "sum", " ", "of", " ", 
       "potential", " ", "terms"}], "*)"}], ";", "\n", 
     RowBox[{"U", " ", "=", " ", 
      RowBox[{
      "Utrap", " ", "+", " ", "UColoumb", " ", "+", " ", "UField", " ", "+", 
