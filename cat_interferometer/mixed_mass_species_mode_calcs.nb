            SuperscriptBox["\[Mu]", "2"], "-", "\[Mu]", "+", "1"}], "]"}]], "*", 
         FractionBox["l", "\[Lambda]"]}]}], ")"}]}]}]}], "\n", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Omega]m", "[", 
