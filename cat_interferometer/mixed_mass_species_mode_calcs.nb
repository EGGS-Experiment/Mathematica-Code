Cell[CellGroupData[{

Cell["Axial Stray Field for Ca-Ca", "Subsection",
 CellChangeTimes->{{4.000833206639738*^9, 4.000833221762224*^9}, {
  4.001194901018076*^9, 
  4.0011949029468594`*^9}},ExpressionUUID->"8bc9026a-3364-f240-a56b-\
4838637e559e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"known", " ", "single", " ", "Ca", " ", "frequencies"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"knownSecFreqs", " ", "=", " ", 
     RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
      RowBox[{"{", 
       RowBox[{".721", ",", " ", "2.246", ",", " ", "2.423"}], "}"}]}]}], 
    ";"}], " ", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"masses", " ", "in", " ", "ion", " ", "chain"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"massArr", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"mCaIon", ",", " ", "mCaIon"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numIons", " ", "=", " ", 
     RowBox[{"Length", "[", "massArr", "]"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"ionPositions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "i", "]"}], ",", " ", 
         RowBox[{"y", "[", "i", "]"}], ",", " ", 
         RowBox[{"z", "[", "i", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "numIons"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\n", "\n", 
   RowBox[{
    RowBox[{"voltRange", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "10"}], ",", " ", "10", ",", " ", "1"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "magic", " ", "number", " ", "from", " ", "what", " ", "I", " ", 
      "understand"}], " ", "-", " ", 
     RowBox[{
     "close", " ", "to", " ", "guggenmos", " ", "thesis", " ", "I", " ", 
      "think"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Kappa]Projection", " ", "=", " ", "2.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simVoltageList", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{"Voltage", ",", "  ", 
       RowBox[{"{", 
        RowBox[{"Voltage", ",", " ", 
         RowBox[{"Min", "[", "voltRange", "]"}], ",", " ", 
         RowBox[{"Max", "[", "voltRange", "]"}], ",", "0.2"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"getSecFreqs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", " ", "massArr", ",", 
        " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ", "numIons", ",", 
        " ", "ionPositions"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"secFreqs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"getSecFreqs", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", "Volt", ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", "Volt", ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
           "massArr", ",", " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ",
            "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"maxSecFreq", " ", "=", " ", 
     RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simPlot", " ", "=", " ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"getSecFreqs", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                FractionBox[
                 RowBox[{"\[Kappa]Projection", "*", 
                  RowBox[{"(", "Voltage", ")"}]}], 
                 RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
                FractionBox[
                 RowBox[{"\[Kappa]Projection", "*", 
                  RowBox[{"(", "Voltage", ")"}]}], 
                 RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", 
              " ", "massArr", ",", " ", "knownSecFreqs", ",", " ", "mCaIon", ",",
               " ", "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", " ", 
          RowBox[{"Max", "[", "secFreqs", "]"}]}], ")"}], "*", "MHz"}], ",", 
       "\n", 
       RowBox[{"{", 
        RowBox[{"Voltage", ",", " ", 
         RowBox[{"Min", "[", "simVoltageList", "]"}], ",", " ", 
         RowBox[{"Max", "[", "simVoltageList", "]"}]}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", " ", 
          RowBox[{"Thickness", "->", "0.01"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\n", "\n", "\n", 
   RowBox[{"AxialCOMStrayFieldPlot", " ", "=", " ", 
    RowBox[{"Show", "[", "\n", 
     RowBox[{
      RowBox[{"{", "simPlot", "}"}], ",", "\n", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Shim Voltage\>\"", ",", " ", "16"}], "]"}], ",", " ", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Axial COM Shift (Hz)\>\"", ",", " ", "16"}], "]"}]}], 
        "}"}]}], ",", " ", 
      RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
      RowBox[{"Frame", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}]}], ",", "\n", 
      RowBox[{"GridLines", "->", "Automatic"}], ",", "\n", 
      RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", "\n", 
      RowBox[{"VertexStyle", " ", "->", " ", "Black"}], ",", " ", "\n", 
      RowBox[{"LabelStyle", "->", "Black"}]}], "\n", "]"}]}], "\n", 
   "\n"}]}]], "Code",
 CellChangeTimes->{{4.0008332252458515`*^9, 4.0008332435042*^9}, {
