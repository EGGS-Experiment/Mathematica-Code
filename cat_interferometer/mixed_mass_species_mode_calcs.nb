Cell[BoxData[
 RowBox[{
  RowBox[{"getEquilibriumPositions", "[", 
   RowBox[{"U_", ",", "numIons_", ",", " ", "ionEqPositions_"}], "]"}], " ", ":=", 
  RowBox[{"Module", "[", "\n", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "zGuess", ",", " ", "guessPositions", ",", " ", 
      "ionEquilibriumPositions"}], "}"}], ",", " ", "\n", "\n", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Start", " ", "with", " ", "guess", " ", "where", " ", "ions", " ", 
       "are", " ", "spaced", " ", "10", " ", "mincrons", " ", "apart", " ", 
       "and", " ", "lie", " ", "along", " ", "z"}], "-", "axis", " ", "-", 
      " ", "heuristic"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"zGuess", " ", "=", " ", 
      RowBox[{"10", "*", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", "i", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"-", 
             FractionBox[
              RowBox[{"(", 
               RowBox[{"numIons", "-", "1"}], ")"}], "2"]}], ",", " ", 
            FractionBox[
             RowBox[{"(", 
              RowBox[{"numIons", "-", "1"}], ")"}], "2"], ",", "1"}], "}"}]}],
          "]"}], "]"}], "*", "\[Mu]m"}]}], ";", "\n", 
     RowBox[{"guessPositions", " ", "=", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"z", "[", "i", "]"}], ",", 
              RowBox[{"zGuess", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"y", "[", "i", "]"}], ",", "0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", "[", "i", "]"}], ",", "0"}], "}"}]}], "}"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "numIons"}], "}"}]}], "]"}], ",", 
        "1"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Solve", " ", "ion", " ", "equilibrium", " ", "positions", " ", "via", 
