Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"comsolData", " ", "=", " ", 
    RowBox[{"Drop", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<Z:\\\\motion\\\\Mathematica\\\\cat_interferometer\\\\\
comsol\\\\trap axial voltage (0_02 mesh).txt\>\"", ",", " ", "\"\<Table\>\"", 
        ",", " ", 
        RowBox[{"\"\<FieldSeparators\>\"", " ", "->", " ", "\"\<,\>\""}]}], 
       "]"}], ",", " ", "8"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Length", "[", "comsolData", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"comsolData", " ", "=", " ", 
    RowBox[{"comsolData", "[", 
     RowBox[{"[", 
      RowBox[{"10", ";;", "35"}], "]"}], "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"zPos", " ", "=", " ", 
   RowBox[{"comsolData", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"potentials", " ", "=", " ", 
    RowBox[{"comsolData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"V0", " ", "+", "  ", 
    RowBox[{"\[Kappa]", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "-", "z0"}], ")"}], "^", "2"}], "*", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"g3", "*", 
        RowBox[{"(", 
         RowBox[{"z", "-", "z0"}], ")"}]}], " ", "+", " ", 
       RowBox[{"g4", " ", "*", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"z", "-", "z0"}], ")"}], "2"]}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{"nlm", " ", "=", " ", 
  RowBox[{"NonlinearModelFit", "[", 
   RowBox[{"comsolData", ",", " ", "model", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Kappa]", ",", " ", "1"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"V0", ",", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"g1", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"g3", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"g4", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z0", ",", 
        RowBox[{"-", "0.1"}]}], "}"}]}], "}"}], ",", " ", "z"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"dataPlot", " ", "=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"Thread", "[", 
     RowBox[{"{", 
      RowBox[{"zPos", ",", " ", "potentials"}], "}"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fitPlot", " ", "=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"nlm", "[", "z", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", 
       RowBox[{"Min", "[", "zPos", "]"}], ",", 
       RowBox[{"Max", "[", "zPos", "]"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dataPlot", ",", " ", "fitPlot"}], "}"}], ",", " ", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Ion Position (mm)\>\"", ",", 
       " ", "\"\<Potential (V)\>\""}], "}"}]}]}], "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"\[Kappa]Fit", " ", "=", " ", 
   RowBox[{"\[Kappa]", "/.", 
    RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The predicted secular frequency is: \>\"", ",", " ", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "\[Pi]"}], ")"}]}], " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", "qe", "*", "\[Kappa]Fit"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"mCaIon", "*", "amu"}], ")"}]}], "]"}]}], ",", 
   " ", "\"\<kHz\>\""}], "]"}], "\n", 
 RowBox[{
  RowBox[{"g3Fit", " ", "=", " ", 
   RowBox[{"g3", " ", "/.", 
    RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The extracted cubic length scale is: \>\"", ",", " ", 
   RowBox[{"1", "/", "g3Fit"}], ",", " ", "\"\<mm\>\""}], "]"}], "\n", 
 RowBox[{
  RowBox[{"g4Fit", " ", "=", " ", 
   RowBox[{"g4", " ", "/.", 
    RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The extracted quartic length scale is: \>\"", ",", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", "/", "g4Fit"}], "]"}], ",", " ", "\"\<mm\>\""}], 
  "]"}]}], "Code",
