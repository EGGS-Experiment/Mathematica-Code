                  RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
               FractionBox[
                RowBox[{"\[Kappa]", "*", 
                 RowBox[{"(", 
                  RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ",
              "massArr", ",", " ", "knownSecFreqs", ",", " ", "knownMass", ",",
              " ", "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", " ", "maxSecFreq"}], ")"}], "*",
        "MHz"}], ",", "\n", 
      RowBox[{"{", 
       RowBox[{"Voltage", ",", " ", 
        RowBox[{
         FractionBox[
