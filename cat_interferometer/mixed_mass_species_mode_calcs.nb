Cell[CellGroupData[{

Cell["V shim Calibration (see 09/28/2026) data", "Subsection",
 CellChangeTimes->{{4.000828214756317*^9, 4.0008282149510536`*^9}, {
  4.0008331769237537`*^9, 
  4.0008331787741528`*^9}},ExpressionUUID->"f1469e7e-c96a-8544-b392-\
57803d771d60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"known", " ", "single", " ", "Ca", " ", "frequencies"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"knownSecFreqs", " ", "=", " ", 
     RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
      RowBox[{"{", 
       RowBox[{".721", ",", " ", "2.246", ",", " ", "2.423"}], "}"}]}]}], 
    ";"}], " ", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"masses", " ", "in", " ", "ion", " ", "chain"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"massArr", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"mCaIon", ",", " ", "mHCl35", " ", ",", "mCaIon"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"numIons", " ", "=", " ", 
     RowBox[{"Length", "[", "massArr", "]"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"ionPositions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "i", "]"}], ",", " ", 
         RowBox[{"y", "[", "i", "]"}], ",", " ", 
         RowBox[{"z", "[", "i", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "numIons"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"actual", " ", "data"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"actualVoltages", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "50.", ",", " ", "52.", ",", " ", "54.", ",", " ", "56.", ",", " ", 
       "58.", ",", " ", "60.", ",", " ", "62.", ",", " ", "64.", ",", " ", 
       "66.", ",", " ", "68.", ",", " ", "70.", ",", " ", "72.", ",", " ", 
       "74.", ",", " ", "76.", ",", " ", "78."}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"actualShiftsHz", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "0.15230465"}], ",", " ", 
        RowBox[{"-", "0.09455746"}], ",", " ", 
        RowBox[{"-", "0.07231661"}], ",", "  ", "0.01465407", ",", " ", 
        RowBox[{"-", "0.00528796"}], ",", "  ", "0.02772544", ",", "\n", "  ",
         "0.03339369", ",", "  ", "0.01143617", ",", "  ", "0.08333202", ",", 
        "  ", "0.05285475", ",", "  ", "0.07740368", ",", "  ", "0.02198685", 
        ",", "\n", "  ", "0.0310533", ",", "  ", 
        RowBox[{"-", "0.02497588"}], ",", " ", 
        RowBox[{"-", "0.00439742"}]}], "}"}], " ", "*", " ", "kHz"}]}], ";"}],
    "\n", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"Collect", " ", "and", " ", "process", " ", "data"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"voltRange", " ", "=", " ", 
     RowBox[{
      RowBox[{"Max", "[", "actualVoltages", "]"}], " ", "-", " ", 
      RowBox[{"Min", "[", "actualVoltages", "]"}]}]}], ";"}], "\n", "\n", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"fit", " ", "data", " ", "to", " ", "parabola"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"actualData", " ", "=", " ", 
     RowBox[{"Transpose", "@", 
      RowBox[{"{", 
       RowBox[{"actualVoltages", ",", " ", "actualShiftsHz"}], "}"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"nlm", " ", "=", " ", 
     RowBox[{"NonlinearModelFit", "[", 
      RowBox[{"actualData", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], "*", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "b"}], ")"}], "2"]}], "+", "c"}], ",", 
       RowBox[{"{", 
        RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", " ", "x", ",", " ", 
       RowBox[{"MaxIterations", "->", "1000"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"voltMidPoint", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b", ",", "c"}], "}"}], "/.", " ", 
        RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}], ")"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"voltageList", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", 
       RowBox[{
        FractionBox["voltRange", "2"], "+", "voltMidPoint"}]}], "]"}]}], 
    ";"}], " ", "\n", "\n", 
   RowBox[{
    RowBox[{"dataPlot", " ", "=", " ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"Thread", "[", 
       RowBox[{"{", 
        RowBox[{"actualVoltages", ",", " ", 
         RowBox[{"actualShiftsHz", " ", "-", " ", 
          RowBox[{"Max", "[", "actualData", "]"}]}]}], "}"}], "]"}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "magic", " ", "number", " ", "from", " ", "what", " ", "I", " ", 
      "understand"}], " ", "-", " ", 
     RowBox[{
     "close", " ", "to", " ", "guggenmos", " ", "thesis", " ", "I", " ", 
      "think"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Kappa]Projection", " ", "=", " ", "2.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simVoltageList", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{"Voltage", ",", "  ", 
       RowBox[{"{", 
        RowBox[{"Voltage", ",", " ", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", " ", 
         RowBox[{
          FractionBox["voltRange", "2"], "+", "voltMidPoint"}], ",", "0.1"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxSecFreq", " ", "=", " ", 
     RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"getSecFreqs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", " ", "massArr", ",", 
        " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ", "numIons", ",", 
        " ", "ionPositions"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"secFreqs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"getSecFreqs", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", 
                RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", 
                RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
           "massArr", ",", " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ",
            "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"Volt", ",", " ", "voltageList"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simPlot", " ", "=", " ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"getSecFreqs", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                FractionBox[
                 RowBox[{"\[Kappa]Projection", "*", 
                  RowBox[{"(", 
                   RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                 RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
                FractionBox[
                 RowBox[{"\[Kappa]Projection", "*", 
                  RowBox[{"(", 
                   RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                 RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", 
