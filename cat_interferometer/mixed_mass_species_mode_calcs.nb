      "rads", " ", "to", " ", "MHz"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"singleIonSecFreqs", " ", "=", " ", 
      RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
       RowBox[{"{", 
        RowBox[{"Sec1", ",", " ", "Sec2", ",", " ", "Sec3"}], "}"}]}]}], ";", 
     "\n", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "create", " ", "a", " ", "voltage", " ", "scan", " ", "about", " ", "a",
        " ", "provided", " ", "center", " ", "point"}], "*)"}], "\n", 
     RowBox[{"simVoltageList", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{"Voltage", ",", "  ", 
        RowBox[{"{", 
         RowBox[{"Voltage", ",", " ", 
          RowBox[{
           FractionBox[
            RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", " ", 
          RowBox[{
           FractionBox["voltRange", "2"], "+", "voltMidPoint"}], ",", 
          FractionBox["voltRange", "10"]}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Convert", " ", "voltage", " ", "scan", " ", "to", " ", "electric", " ",
        "field", " ", "the", " ", "ion", " ", "sees", " ", "\n", 
       "\[Kappa]Projection", " ", "is", " ", "a", " ", "magic", " ", "number",
        " ", "from", " ", "what", " ", "I", " ", "gather", "\n", "assume", " ",
        "voltage", " ", "produces", " ", "equal", " ", "electric", " ", 
       "field", " ", "aong", " ", "both", " ", "axes"}], "*)"}], "\n", 
     RowBox[{"\[Kappa]Projection", " ", "=", " ", "0.077"}], ";", "\n", 
     RowBox[{"secFreqs", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"getAxialRock", "[", 
         RowBox[{"getSecFreqs", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", 
                RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", 
