 RowBox[{
  RowBox[{"\[Omega]p", "[", 
   RowBox[{
   "\[Kappa]_", ",", " ", "\[Mu]_", ",", " ", "m1_", ",", " ", "\[Lambda]_"}],
    "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\n", 
