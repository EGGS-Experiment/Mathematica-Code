Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"comsolRadialData", " ", "=", " ", 
    RowBox[{"Drop", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<Z:\\\\motion\\\\Mathematica\\\\cat_interferometer\\\\\
comsol\\\\trap radial voltage.txt\>\"", ",", " ", "\"\<Table\>\"", ",", " ", 
        RowBox[{"\"\<FieldSeparators\>\"", " ", "->", " ", "\"\<,\>\""}]}], 
       "]"}], ",", " ", "8"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Velectrode", " ", "=", " ", "395"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Vbase", " ", "=", " ", "300"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "voltage", " ", "used", " ", "in", " ", "COMSOL", " ", "simulation", " ", 
    "to", " ", "generate", " ", "data"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Length", "[", "comsolRadialData", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"comsolRadialData", " ", "=", " ", 
    RowBox[{"comsolRadialData", "[", 
     RowBox[{"[", 
      RowBox[{"21", ";;", "50"}], "]"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "take", " ", "data", " ", "near", " ", "ions", " ", "equilibrium", " ", 
    "position"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"radialPos", " ", "=", " ", 
   RowBox[{"comsolRadialData", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"radialPotentials", " ", "=", " ", 
    RowBox[{
     RowBox[{"comsolRadialData", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], " ", "*", " ", 
     RowBox[{"Velectrode", "/", "Vbase"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dataPlot", " ", "=", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"Thread", "[", 
     RowBox[{"{", 
      RowBox[{"radialPos", ",", " ", "radialPotentials"}], "}"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"model", " ", "=", " ", 
    RowBox[{"V0", " ", "+", " ", 
     RowBox[{"\[Kappa]", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", "-", "r00"}], ")"}], "^", "2"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"fit", " ", "to", " ", "simple", " ", "parabola"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"nlm", " ", "=", " ", 
   RowBox[{"NonlinearModelFit", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"radialPos", ",", " ", "radialPotentials"}], "}"}], "]"}], ",",
      " ", "model", ",", " ", 
     RowBox[{"{", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"V0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Kappa]", ",", " ", "100"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r00", ",", 
         RowBox[{"-", "0.1"}]}], "}"}]}], "}"}], ",", " ", "r"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fitPlot", " ", "=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"nlm", "[", "r", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"Min", "[", "radialPos", "]"}], ",", 
       RowBox[{"Max", "[", "radialPos", "]"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dataPlot", ",", " ", "fitPlot"}], "}"}], ",", " ", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Ion Position (mm)\>\"", ",", 
       " ", "\"\<Potential (V)\>\""}], "}"}]}]}], "]"}], "\n", "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"extract", " ", "mathieu", " ", "parameters"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Kappa]Fit", " ", "=", " ", 
   RowBox[{"\[Kappa]", " ", "/.", 
    RowBox[{"nlm", "[", "\"\<BestFitParameters\>\"", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Kappa]Fit", " ", "=", " ", 
    RowBox[{"\[Kappa]Fit", " ", "/", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["10", 
        RowBox[{"-", "3"}]], ")"}], "2"]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"convert", " ", "from", " ", 
    RowBox[{"V", "/", 
     SuperscriptBox["mm", "2"]}], " ", "to", " ", 
    RowBox[{"V", "/", 
     SuperscriptBox["m", "2"]}]}], "*)"}], "\n", "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"see", " ", "roos", " ", "thesis", " ", "2.1"}], "-", "2.6"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qr", " ", "=", " ", 
    FractionBox[
     RowBox[{"4", " ", "*", " ", "\[Kappa]Fit", " ", "*", " ", "qe"}], 
     RowBox[{"mCaIon", "*", "amu", "*", 
      SuperscriptBox["\[CapitalOmega]RF", "2"]}]]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"roos", " ", "eqn", " ", "2.4"}], ",", " ", 
    RowBox[{"\[Kappa]Fit", " ", "=", " ", 
     RowBox[{"\[Alpha]", "*", 
      FractionBox["V", 
       SuperscriptBox[
        OverscriptBox["r", "~"], "2"]]}]}], ",", " ", 
    RowBox[{"see", " ", 
     RowBox[{"eqn", ".", " ", "at"}], " ", "top", " ", "of", " ", "section", " ",
      "for", " ", "converting", " ", "\[Kappa]Fit", " ", "to", " ", 
     "physical", " ", "parameters"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", " ", "=", " ", 
    FractionBox[
     RowBox[{"\[Kappa]Fit", "*", 
      SuperscriptBox["r0", "2"]}], "397"]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", " ", "=", " ", 
    RowBox[{
     RowBox[{"\[CapitalOmega]RF", "/", "2"}], " ", "*", " ", 
     RowBox[{"Sqrt", "[", 
      FractionBox[
       SuperscriptBox["qr", "2"], "2"], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"roos", " ", "2.6"}], " ", "-", " ", 
     RowBox[{"set", " ", "a"}]}], " ", "=", 
    RowBox[{"0", " ", "for", " ", "easy", " ", "approximation"}]}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   FractionBox["\[Omega]", 
    RowBox[{"2", "*", "\[Pi]"}]]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The predicted Mathieu q is: \>\"", ",", " ", "qr"}], "]"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The predicted radial secular frequency is: \>\"", ",", " ", 
   FractionBox["f", "MHz"], ",", " ", "\"\< MHz\>\""}], "]"}]}], "Code",
 CellChangeTimes->{{4.001092121140938*^9, 4.0010923299774075`*^9}, {
  4.0010926058011417`*^9, 4.001092722384735*^9}, {4.0010927770836353`*^9, 
