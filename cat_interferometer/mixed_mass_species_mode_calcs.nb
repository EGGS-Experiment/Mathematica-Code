Cell[BoxData[
 RowBox[{
  RowBox[{"SimDiffSecFreqs", "[", 
   RowBox[{"Sec1_", ",", " ", "Sec2_", ",", " ", "Sec3_", ",", " ", 
    RowBox[{"voltRange_", ":", "20"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\n", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "singleIonSecFreqs", ",", " ", "SecFreqs", ",", " ", "maxSecFreqShift", ",",
       " ", "simVoltageList", ",", " ", "secFreqs"}], "}"}], ",", "\n", "\n", 
    RowBox[{"(*", 
     RowBox[{
