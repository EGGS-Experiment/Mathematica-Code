Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"knownSecFreqs", " ", "=", " ", 
   RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
    RowBox[{"{", 
     RowBox[{".71", ",", " ", "2.22", ",", " ", "2.4"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"knownMass", " ", "=", " ", "39.962590863"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"mUnknown", " ", "=", " ", "36"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"massArr", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"knownMass", ",", " ", "mUnknown", ",", " ", "knownMass"}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eggFreqSpan", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"eggsFreq", ",", " ", 
     RowBox[{"{", 
      RowBox[{"eggsFreq", ",", " ", "1.500", ",", " ", "2.40", ",", ".01"}], 
      "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"freqShift", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{"\[AliasDelimiter]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"[", 
        RowBox[{".71", ",", 
         RowBox[{"eggsFreq", "-", ".2"}], ",", "eggsFreq"}], "]"}], ",", " ", 
       RowBox[{"{", 
