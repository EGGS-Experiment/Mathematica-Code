                FractionBox[
                 RowBox[{"\[Kappa]Projection", "*", 
                  RowBox[{"(", "Voltage", ")"}]}], 
                 RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
                FractionBox[
                 RowBox[{"\[Kappa]Projection", "*", 
