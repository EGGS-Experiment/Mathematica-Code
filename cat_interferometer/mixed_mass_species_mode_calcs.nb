Cell[BoxData[
 RowBox[{
  RowBox[{"getModeParams", "[", 
   RowBox[{
   "U_", ",", " ", "massArr_", ",", " ", "ionEquilibriumPositions_", ",", " ",
     "numIons_", ",", "ionPositions_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "evals", ",", " ", "evecs", ",", "\n", "M", ",", " ", "H", ",", " ", 
      "orderingIndices", ",", " ", "evecsSorted", ",", " ", "evecsNormalized",
       ",", " ", "evalsSorted", ",", " ", "secFreqsMHz"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"H", " ", "=", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"U", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Flatten", "[", "ionPositions", "]"}], ",", " ", "2"}], 
          "}"}]}], "]"}], "/.", "ionEquilibriumPositions"}]}], ";", "\n", 
     RowBox[{"M", " ", "=", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"massArr", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", "amu", "*", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "numIons"}], "}"}]}], "]"}], "]"}], "]"}]}],
      ";", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"evals", ",", " ", "evecs"}], "}"}], " ", "=", " ", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"Inverse", "[", "M", "]"}], "]"}], ".", "H", ".", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"Inverse", "[", "M", "]"}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"orderingIndices", " ", "=", " ", 
      RowBox[{"Ordering", "[", "evals", "]"}]}], ";", "\n", 
     RowBox[{"evecsSorted", " ", "=", " ", 
      RowBox[{"evecs", "[", 
       RowBox[{"[", "orderingIndices", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"evecsNormalized", " ", "=", " ", 
      RowBox[{"Chop", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Normalize", "[", 
          RowBox[{"evecsSorted", "[", 
           RowBox[{"[", "idx", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"idx", ",", " ", 
           RowBox[{"Length", "[", "evecsSorted", "]"}]}], "}"}]}], "]"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"evalsSorted", " ", "=", " ", 
      RowBox[{"evals", "[", 
       RowBox[{"[", "orderingIndices", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"secFreqsMHz", " ", "=", " ", 
      RowBox[{"Chop", "[", 
       FractionBox[
        RowBox[{"Sqrt", "[", "evalsSorted", "]"}], 
        RowBox[{"2", "*", "\[Pi]", "*", "MHz"}]], "]"}]}], ";", "\n", 
     RowBox[{"{", 
      RowBox[{"evecsNormalized", ",", " ", "secFreqsMHz"}], "}"}]}]}], "\n", 
   "]"}]}]], "Code",
