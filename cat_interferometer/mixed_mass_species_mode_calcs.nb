 RowBox[{
  RowBox[{"\[Omega]c", "[", 
   RowBox[{"\[Kappa]_", ",", " ", "m_", ",", " ", "\[Lambda]_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", "\n", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"l", " ", "=", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["qe", 
         RowBox[{"8", "*", "\[Pi]", "*", "e0", "*", "\[Kappa]"}]], ")"}], 
       RowBox[{"1", "/", "3"}]]}], ";", "\n", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       FractionBox[
        RowBox[{"2", "*", "qe", "*", "\[Kappa]"}], 
        RowBox[{"m", "*", "amu"}]], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["9", 
          SuperscriptBox["2", 
           RowBox[{"7", "/", "3"}]]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["l", "\[Lambda]"], ")"}], "2"]}]}], ")"}]}]}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Omega]s", "[", 
   RowBox[{"\[Kappa]_", ",", " ", "m_", ",", " ", "\[Lambda]_"}], "]"}], ":=",
   " ", 
  RowBox[{"Module", "[", "\n", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"l", " ", "=", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["qe", 
         RowBox[{"8", "*", "\[Pi]", "*", "e0", "*", "\[Kappa]"}]], ")"}], 
       RowBox[{"1", "/", "3"}]]}], ";", "\n", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       FractionBox[
        RowBox[{"6", "*", "qe", "*", "\[Kappa]"}], 
        RowBox[{"m", "*", "amu"}]], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["3", 
          SuperscriptBox["2", 
           RowBox[{"7", "/", "3"}]]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["l", "\[Lambda]"], ")"}], "2"]}]}], ")"}]}]}]}], 
