Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cubicShiftCOM", "[", 
    RowBox[{
    "leftMass_", ",", " ", "rightMass_", ",", " ", "\[Lambda]3_", ",", " ", 
     "\[Kappa]_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"\[Omega]m", "[", 
      RowBox[{"\[Kappa]", ",", " ", 
       RowBox[{"leftMass", "/", "rightMass"}], ",", " ", "leftMass", ",", " ",
        "\[Lambda]3"}], "]"}], 
     RowBox[{"2", "*", "\[Pi]"}]], "-", 
    FractionBox[
     RowBox[{"\[Omega]m", "[", 
      RowBox[{"\[Kappa]", ",", " ", 
       RowBox[{"rightMass", "/", "leftMass"}], ",", " ", "rightMass", ",", 
       " ", "\[Lambda]3"}], "]"}], 
     RowBox[{"2", "*", "\[Pi]"}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cubicShiftZZ", "[", 
     RowBox[{
     "leftMass_", ",", " ", "rightMass_", ",", " ", "\[Lambda]3_", ",", " ", 
      "\[Kappa]_"}], "]"}], ":=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Omega]p", "[", 
       RowBox[{"\[Kappa]", ",", " ", 
        RowBox[{"leftMass", "/", "rightMass"}], ",", " ", "leftMass", ",", 
        " ", "\[Lambda]3"}], "]"}], 
      RowBox[{"2", "*", "\[Pi]"}]], "-", 
     FractionBox[
      RowBox[{"\[Omega]p", "[", 
       RowBox[{"\[Kappa]", ",", " ", 
        RowBox[{"rightMass", "/", "leftMass"}], ",", " ", "rightMass", ",", 
        " ", "\[Lambda]3"}], "]"}], 
      RowBox[{"2", "*", "\[Pi]"}]]}]}], ";"}], "\n", "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Solve", " ", "for", " ", "predicted", " ", "cubic", " ", 
    "anharmonicity"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"data", " ", "from", " ", "rids", " ", "165469", " ", 
     RowBox[{"(", 
      RowBox[{"Ca", "+", " ", 
       RowBox[{"on", " ", "right"}]}], ")"}], " ", "and", " ", "165463", " ", 
     RowBox[{"(", 
      RowBox[{"Ca", "+", " ", 
       RowBox[{"on", " ", "left"}]}], ")"}], "\n", "  ", "H_", 
     RowBox[{
      RowBox[{"{", "2", "}"}], " ", "^", 
      RowBox[{"{", "37", "}"}]}], "Cl"}], "+", " ", 
    RowBox[{"used", " ", "as", " ", "dark", " ", "ion"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mIonLeft", " ", "=", " ", "mCaIon"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mIonRight", " ", "=", " ", "mH2Cl37"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ionSwapFreqShift", " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "3"}], "*", "Hz"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cubicLambdaSol", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cubicShiftCOM", "[", 
          RowBox[{"mIonLeft", ",", " ", "mIonRight", ",", " ", 
           RowBox[{"1", "/", "g3"}], ",", " ", "\[Kappa]\[Kappa]"}], "]"}], "==",
          "\[Delta]"}], ",", " ", "g3"}], "]"}], ",", " ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"mLeft", ">", "0"}], " ", "&&", " ", 
        RowBox[{"mRight", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"\[Omega]", ">", "0"}], " ", "&&", " ", 
        RowBox[{"\[Kappa]\[Kappa]", " ", ">", " ", "0"}]}]}]}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"g3SolInvMeters", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"cubicLambdaSol", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mLeft", "->", "mIonLeft"}], ",", " ", 
      RowBox[{"mRight", "->", "mIonRight"}], ",", " ", 
      RowBox[{"\[Delta]", "->", "ionSwapFreqShift"}], ",", " ", 
      RowBox[{"\[Kappa]\[Kappa]", "->", "\[Kappa]c"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g3SolInvMillimeters", " ", "=", " ", 
   RowBox[{"g3SolInvMeters", "/", "1000"}]}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Propagate", " ", "error"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]fLeft", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", "0.0022", ")"}], "*", "kHz"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]fRight", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", "0.0025", ")"}], "*", "kHz"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]\[Delta]", " ", "=", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      SuperscriptBox["\[Sigma]fLeft", "2"], "+", 
      SuperscriptBox["\[Sigma]fRight", "2"]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"find", " ", "actual", " ", "value"}], "*)"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errorPropFactor", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"cubicLambdaSol", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"mLeft", "->", "mIonLeft"}], ",", " ", 
             RowBox[{"mRight", "->", "mIonRight"}], ",", " ", 
             RowBox[{"\[Kappa]\[Kappa]", "->", "\[Kappa]c"}]}], "}"}], 
           "}"}]}], ",", " ", "\[Delta]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", "->", "ionSwapFreqShift"}], "}"}]}], ")"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"g3ErrorInvMeters", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     SuperscriptBox["errorPropFactor", "2"], "*", 
     SuperscriptBox["\[Sigma]\[Delta]", "2"]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g3ErrorInvMillimeters", " ", "=", " ", 
   RowBox[{"g3ErrorInvMeters", " ", "/", "1000"}]}], "\n"}], "\n", 
 RowBox[{"Print", "[", 
