Cell[CellGroupData[{

Cell["\<\
See trend of stray fields and shift caused for different secular frequency \
configurations\
\>", "Subsection",
 CellChangeTimes->{{3.997016419700346*^9, 
  3.9970164382327547`*^9}},ExpressionUUID->"6b5a0e0b-ee25-4e5f-a35e-\
52b6e292812e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testSecFreqs", " ", "=", " ", 
   RowBox[{"2", "*", "\[Pi]", "*", 
    RowBox[{"{", 
     RowBox[{".71", ",", " ", "1.5", ",", " ", "1.8"}], "}"}], "*", "MHz"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"secFreqs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"getAxialRock", "[", 
      RowBox[{"getSecFreqs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox[
           RowBox[{"\[Kappa]", "*", 
            RowBox[{"(", 
             RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
           RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
          FractionBox[
           RowBox[{"\[Kappa]", "*", 
            RowBox[{"(", 
             RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
           RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
        "massArr", ",", " ", "testSecFreqs", ",", " ", "knownMass", ",", " ", 
        "numIons", ",", " ", "ionPositions"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxSecFreq", " ", "=", " ", 
    RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"getAxialRock", "[", 
          RowBox[{"getSecFreqs", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              FractionBox[
               RowBox[{"\[Kappa]", "*", 
                RowBox[{"(", 
                 RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
               RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
              FractionBox[
               RowBox[{"\[Kappa]", "*", 
                RowBox[{"(", 
                 RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
               RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
            "massArr", ",", " ", "testSecFreqs", ",", " ", "knownMass", ",", 
            " ", "numIons", ",", " ", "ionPositions"}], "]"}], "]"}], "-", 
         "maxSecFreq"}], ")"}], "*", "MHz"}], ",", "\n", 
      RowBox[{"{", 
       RowBox[{"Voltage", ",", " ", 
        RowBox[{
         FractionBox[
          RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", 
        RowBox[{
         FractionBox["voltRange", "2"], "+", "voltMidPoint"}]}], "}"}], ",", 
      " ", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Black", ",", " ", 
         RowBox[{"Thickness", "->", "0.01"}]}], "}"}]}]}], "]"}], "}"}], ",", 
   "\n", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Horizontal Shim Voltages\>\"", ",", " ", "16"}], "]"}], ",",
       " ", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Secular Freq Shift (Hz)\>\"", ",", " ", "16"}], "]"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
   RowBox[{"Frame", "->", 
    RowBox[{"{", 
