Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "mass", " ", "independent", " ", "mathieu", " ", 
    "equations"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"getMathieuParams", "[", 
    RowBox[{
    "knownSecFreqs_", ",", " ", "knownMass_", ",", " ", 
     "\[CapitalOmega]RF_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "knownSecFreqsSorted", ",", " ", "ar", ",", " ", "az", ",", " ", "qx"}],
       "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"knownSecFreqsSorted", " ", "=", " ", 
       RowBox[{"knownSecFreqs", "[", 
        RowBox[{"[", 
         RowBox[{"Ordering", "[", "knownSecFreqs", "]"}], "]"}], "]"}]}], ";",
       "\n", 
      RowBox[{"(*", 
       RowBox[{
       "get", " ", "source", " ", "for", " ", "these", " ", "formulas"}], 
       "*)"}], "\n", 
      RowBox[{"ar", " ", "=", " ", 
       RowBox[{
        FractionBox["2", 
         SuperscriptBox["\[CapitalOmega]RF", "2"]], "*", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"knownSecFreqsSorted", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "2"], "-", 
          SuperscriptBox[
           RowBox[{"knownSecFreqsSorted", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "2"]}], ")"}]}]}], ";", "\n", 
      RowBox[{"az", " ", "=", " ", 
       RowBox[{
        FractionBox["4", 
         SuperscriptBox["\[CapitalOmega]RF", "2"]], "*", 
        SuperscriptBox[
         RowBox[{"knownSecFreqsSorted", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "2"]}]}], ";", "\n", 
      RowBox[{"qx", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"8", "*", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"knownSecFreqsSorted", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "2"], 
           SuperscriptBox["\[CapitalOmega]RF", "2"]]}], "-", 
         RowBox[{"(", 
          RowBox[{"ar", "-", 
           RowBox[{"2", "*", "az"}]}], ")"}]}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ar", ",", " ", "az", ",", " ", "qx"}], "}"}], "*", 
       "knownMass"}]}]}], "\n", "]"}]}]}]], "Code",
