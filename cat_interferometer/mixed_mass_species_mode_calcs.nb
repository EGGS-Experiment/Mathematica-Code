Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"G3", ",", " ", "G4", ",", " ", "secFreqsMHz"}], "}"}], " ", "=",
      " ", 
     RowBox[{"getPerturbationTensors", "[", 
      RowBox[{
      "EField", ",", " ", "\n", "\t", "massArr", ",", " ", "knownSecFreqs", ",",
        " ", "knownMass", ",", " ", "numIons", ",", " ", "ionPositions", ",", 
       " ", "\[Beta]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numModes", " ", "=", " ", 
     RowBox[{"Length", "[", "nList", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intermediateStates", " ", "=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"createCandidateStates", "[", 
        RowBox[{"nList", ",", " ", "numModes"}], "]"}], ",", " ", "nList"}], 
      "]"}]}], ";"}], "\n", 
