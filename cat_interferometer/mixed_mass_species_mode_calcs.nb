Cell[CellGroupData[{

Cell["Coulomb Anharmonic Calculations", "Section",
 CellChangeTimes->{{3.9977993029542255`*^9, 3.9977993075444183`*^9}, {
  3.9981488937733345`*^9, 3.99814892194882*^9}, {3.9981489530457897`*^9, 
