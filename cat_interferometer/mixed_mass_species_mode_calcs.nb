            "}"}]}], ",", " ", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Red", ",", " ", 
             RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}]}], "]"}]}], 
       "}"}], ",", "\n", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Shim Voltage\>\"", ",", " ", "16"}], "]"}], ",", " ", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Axial ZZ Shift (Hz)\>\"", ",", " ", "16"}], "]"}]}], 
        "}"}]}], ",", " ", 
      RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
      RowBox[{"Frame", "->", 
       RowBox[{"{", 
