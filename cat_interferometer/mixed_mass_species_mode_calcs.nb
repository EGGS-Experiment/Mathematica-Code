            SuperscriptBox[
             RowBox[{"z", "[", "i", "]"}], "2"]}]}], ")"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], "]"}]}], 
     ";", "\n", 
     RowBox[{"UColoumb", " ", "=", " ", 
      RowBox[{
       FractionBox[
        SuperscriptBox["qe", "2"], 
        RowBox[{"4", "*", "\[Pi]", "*", "e0"}]], "*", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"Sum", "[", " ", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"x", "[", "i", "]"}], "-", 
                 RowBox[{"x", "[", "j", "]"}]}], ")"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"y", "[", "i", "]"}], "-", 
                 RowBox[{"y", "[", "j", "]"}]}], ")"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"z", "[", "i", "]"}], "-", 
                 RowBox[{"z", "[", "j", "]"}]}], ")"}], "2"]}], "]"}]], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", " ", 
             RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], 
        "]"}]}]}], ";", "\n", 
     RowBox[{"UField", " ", "=", " ", 
      RowBox[{
       RowBox[{"-", "qe"}], "*", 
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"ionPositions", "*", "EFieldMat"}], "]"}], "]"}]}]}], ";", 
     "\n", 
     RowBox[{"Uanharmonic", " ", "=", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"qe", "*", "\[Beta]", "*", 
          SuperscriptBox[
           RowBox[{"z", "[", "i", "]"}], "3"]}], "+", 
         RowBox[{"qe", "*", "\[Gamma]", "*", 
          SuperscriptBox[
           RowBox[{"z", "[", "i", "]"}], "4"]}], " ", "+", " ", 
         RowBox[{"qe", " ", "*", " ", "\[Delta]", "*", 
          SuperscriptBox[
           RowBox[{"z", "[", "i", "]"}], "5"]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], "]"}]}], 
     ";", "\n", 
     RowBox[{"U", " ", "=", " ", 
      RowBox[{"Utrap", "+", "UColoumb", "+", "UField", "+", "Uanharmonic"}]}],
      ";", "\n", "U"}]}], "\n", "]"}]}]], "Code",
