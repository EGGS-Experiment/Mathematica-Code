Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"acutal", " ", "data"}], "*)"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"known", " ", "single", " ", "Ca", " ", "frequencies"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"knownSecFreqs", " ", "=", " ", 
     RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
      RowBox[{"{", 
       RowBox[{".71", ",", " ", "1.3242", ",", " ", "1.6096"}], "}"}]}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Frequencies", " ", "from", " ", 
      RowBox[{"Hao", "'"}], "s", " ", "Calibration", " ", "on", " ", "06"}], "-",
      "04", " ", "-", " ", 
     RowBox[{
     "keep", " ", "these", " ", "and", " ", "if", " ", "need", " ", "to", " ",
       "change", " ", "override", " ", "later"}]}], "*)"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"masses", " ", "in", " ", "ion", " ", "chain"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"massArr", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"mCaIon", ",", " ", "mHCl35", ",", " ", "mCaIon"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"numIons", " ", "=", " ", 
     RowBox[{"Length", "[", "massArr", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ionPositions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "i", "]"}], ",", " ", 
         RowBox[{"y", "[", "i", "]"}], ",", " ", 
         RowBox[{"z", "[", "i", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "numIons"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "find", " ", "where", " ", "Hao", " ", "took", " ", "this", " ", "data"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"actualVoltageList", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
      "42.79", ",", " ", "62.79", ",", " ", "52.79", ",", " ", "44.79", ",", 
       " ", "60.79", ",", " ", "47.8", ",", " ", "52.79", ",", " ", "57.8", ",",
        "55.79", ",", "52.79", ",", " ", "58.8", ",", " ", "56.8"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"offsetSecFreqHz", " ", "=", " ", 
     RowBox[{"{", 
