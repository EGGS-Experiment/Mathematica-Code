Cell[BoxData[
 RowBox[{
  RowBox[{"getPotential", "[", 
   RowBox[{
   "massArr_", ",", " ", "massIndepSecFreqs_", ",", " ", "numIons_", ",", " ",
     "EField_", ",", " ", "ionPositions_", ",", "\n", 
    RowBox[{"\[Beta]_", ":", "0"}], ",", " ", 
    RowBox[{"\[Gamma]_", ":", "0"}], ",", " ", 
    RowBox[{"\[Delta]_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "independentAxialFreqs", ",", " ", "independentEGGsFreqs", ",", 
      "independentRFFreqs", ",", "\n", "Utrap", ",", " ", "UColoumb", ",", 
      " ", "UField", ",", " ", "Uanharmonic", ",", " ", "U", ",", " ", 
      "EFieldMat"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"EFieldMat", " ", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"EField", ",", " ", "numIons"}], "]"}]}], ";", "\n", 
     RowBox[{"independentAxialFreqs", " ", "=", " ", 
      RowBox[{"massIndepSecFreqs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"independentRFFreqs", " ", "=", " ", 
      RowBox[{"massIndepSecFreqs", "[", 
