            RowBox[{"[", "2", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", " ", 
          RowBox[{"Max", "[", "secFreqs", "]"}]}], ")"}], "*", "MHz"}], ",", 
       "\n", 
       RowBox[{"{", 
        RowBox[{"Voltage", ",", " ", 
