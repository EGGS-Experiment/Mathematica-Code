                  FractionBox[
                   RowBox[{"\[Kappa]Projection", "*", 
                    RowBox[{"(", 
                    RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                   RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
                  FractionBox[
                   RowBox[{"\[Kappa]Projection", "*", 
                    RowBox[{"(", 
                    RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                   RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", 
                " ", "massArr", ",", " ", "knownSecFreqs", ",", " ", "mCaIon",
                 ",", " ", "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", " ", 
            RowBox[{"Max", "[", "secFreqs", "]"}]}], ")"}], "*", "MHz"}], ",",
          "\n", 
