Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ll", "[", 
    RowBox[{"q_", ",", " ", "secFreqsMHz_"}], "]"}], ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"\[HBar]", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "2", "*", "\[Pi]", "*", 
       RowBox[{"secFreqsMHz", "[", 
