Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ll", "[", 
    RowBox[{"q_", ",", " ", "secFreqsMHz_"}], "]"}], ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"\[HBar]", "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "2", "*", "\[Pi]", "*", 
       RowBox[{"secFreqsMHz", "[", 
        RowBox[{"[", "q", "]"}], "]"}], "*", "MHz"}], ")"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"quarticDiagonalTerms", "[", 
   RowBox[{
   "nList_", ",", " ", "G4_", ",", "  ", "secFreqsMHz_", ",", " ", 
    "numModes_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"ll", "[", 
       RowBox[{"i", ",", "secFreqsMHz"}], "]"}], "4"], "*", 
     RowBox[{"G4", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "i", ",", "i", ",", "i"}], "]"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"6", "*", 
        SuperscriptBox[
         RowBox[{"nList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "2"]}], "+", 
       RowBox[{"6", "*", 
        RowBox[{"nList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "+", "3"}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "numModes"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"quarticOffDiagonalTerms", "[", 
   RowBox[{
   "nList_", ",", " ", "G4_", ",", "  ", "secFreqsMHz_", ",", " ", 
    "numModes_"}], "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{"6", "*", 
     SuperscriptBox[
      RowBox[{"ll", "[", 
       RowBox[{"i", ",", " ", "secFreqsMHz"}], "]"}], "2"], "*", 
     SuperscriptBox[
      RowBox[{"ll", "[", 
       RowBox[{"j", ",", " ", "secFreqsMHz"}], "]"}], "2"], "*", 
     RowBox[{"G4", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "i", ",", "j", ",", "j"}], "]"}], "]"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "*", 
        RowBox[{"nList", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "+", "1"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "*", 
        RowBox[{"nList", "[", 
