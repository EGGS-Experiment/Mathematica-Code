Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"cubicShift", "[", 
     RowBox[{
     "leftMass_", ",", " ", "rightMass_", ",", " ", "\[Lambda]3_", ",", " ", 
      "\[Kappa]_"}], "]"}], ":=", 
    RowBox[{
     FractionBox[
      RowBox[{"\[Omega]m", "[", 
       RowBox[{"\[Kappa]", ",", " ", 
        RowBox[{"leftMass", "/", "rightMass"}], ",", " ", "leftMass", ",", 
        " ", "\[Lambda]3"}], "]"}], 
      RowBox[{"2", "*", "\[Pi]"}]], "-", 
     FractionBox[
      RowBox[{"\[Omega]m", "[", 
       RowBox[{"\[Kappa]", ",", " ", 
        RowBox[{"rightMass", "/", "leftMass"}], ",", " ", "rightMass", ",", 
        " ", "\[Lambda]3"}], "]"}], 
      RowBox[{"2", "*", "\[Pi]"}]]}]}], ";"}], "\n", "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Solve", " ", "for", " ", "predicted", " ", "cubic", " ", 
    "anharmonicity"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mIonLeft", " ", "=", " ", "mCaIon"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mIonRight", " ", "=", " ", "mH2Cl37"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ionSwapFreqShift", " ", "=", " ", 
    RowBox[{"2.9", "*", "Hz"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cubicLambdaSol", " ", "=", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cubicShift", "[", 
          RowBox[{
          "mLeft", ",", " ", "mRight", ",", " ", "\[Lambda]33", ",", " ", 
           "\[Kappa]\[Kappa]"}], "]"}], "==", "\[Delta]"}], ",", " ", 
        "\[Lambda]33"}], "]"}], ",", " ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"mLeft", ">", "0"}], " ", "&&", " ", 
        RowBox[{"mRight", " ", ">", " ", "0"}], " ", "&&", " ", 
        RowBox[{"\[Omega]", ">", "0"}], " ", "&&", " ", 
        RowBox[{"\[Kappa]", " ", ">", " ", "0"}]}]}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]3SolMeters", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"cubicLambdaSol", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mLeft", "->", "mIonLeft"}], ",", " ", 
      RowBox[{"mRight", "->", "mIonRight"}], ",", " ", 
      RowBox[{"\[Delta]", "->", "ionSwapFreqShift"}], ",", " ", 
      RowBox[{"\[Kappa]\[Kappa]", "->", "\[Kappa]c"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]3SolMillimeters", " ", "=", " ", 
   RowBox[{"\[Lambda]3SolMeters", "*", "1000"}]}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Propagate", " ", "error"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]fLeft", " ", "=", " ", 
   RowBox[{"1", "*", "Hz"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]fRight", " ", "=", " ", 
   RowBox[{"1", "*", "Hz"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]\[Delta]", " ", "=", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      SuperscriptBox["\[Sigma]fLeft", "2"], "+", 
      SuperscriptBox["\[Sigma]fRight", "2"]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"find", " ", "actual", " ", "value"}], "*)"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errorPropFactor", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"cubicLambdaSol", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"mLeft", "->", "mIonLeft"}], ",", " ", 
             RowBox[{"mRight", "->", "mIonRight"}], ",", " ", 
             RowBox[{"\[Kappa]\[Kappa]", "->", "\[Kappa]c"}]}], "}"}], 
           "}"}]}], ",", " ", "\[Delta]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", "->", "ionSwapFreqShift"}], "}"}]}], ")"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"\[Lambda]3ErrorMeters", " ", "=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     SuperscriptBox["errorPropFactor", "2"], "*", 
     SuperscriptBox["\[Sigma]\[Delta]", "2"]}], "]"}]}], ";"}], "\n", 
 RowBox[{"\[Lambda]3ErrorMillimeters", " ", "=", " ", 
  RowBox[{"\[Lambda]3ErrorMeters", " ", "*", " ", "1000"}]}]}], "Code",
 CellChangeTimes->{{3.9981205603148785`*^9, 3.9981206524379005`*^9}, {
