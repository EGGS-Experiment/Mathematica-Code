Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"known", " ", "single", " ", "Ca", " ", "frequencies"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"knownSecFreqs", " ", "=", " ", 
     RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
      RowBox[{"{", 
       RowBox[{".721", ",", " ", "2.246", ",", " ", "2.423"}], "}"}]}]}], 
    ";"}], " ", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"masses", " ", "in", " ", "ion", " ", "chain"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"massArr", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"mCaIon", ",", " ", "mCaIon"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numIons", " ", "=", " ", 
     RowBox[{"Length", "[", "massArr", "]"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"ionPositions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "i", "]"}], ",", " ", 
         RowBox[{"y", "[", "i", "]"}], ",", " ", 
         RowBox[{"z", "[", "i", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "numIons"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\n", "\n", 
   RowBox[{
    RowBox[{"voltRange", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "20"}], ",", " ", "20", ",", " ", "1"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "magic", " ", "number", " ", "from", " ", "what", " ", "I", " ", 
      "understand"}], " ", "-", " ", 
     RowBox[{
     "close", " ", "to", " ", "guggenmos", " ", "thesis", " ", "I", " ", 
      "think"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Kappa]Projection", " ", "=", " ", "2.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simVoltageList", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{"Voltage", ",", "  ", 
       RowBox[{"{", 
        RowBox[{"Voltage", ",", " ", 
         RowBox[{"Min", "[", "voltRange", "]"}], ",", " ", 
         RowBox[{"Max", "[", "voltRange", "]"}], ",", "0.2"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"getSecFreqs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", " ", "massArr", ",", 
        " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ", "numIons", ",", 
        " ", "ionPositions"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"secFreqs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"getSecFreqs", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", "Volt", ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", "Volt", ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
           "massArr", ",", " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ",
            "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"Volt", ",", " ", "simVoltageList"}], "}"}]}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"maxSecFreq", " ", "=", " ", 
     RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simPlot", " ", "=", " ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
