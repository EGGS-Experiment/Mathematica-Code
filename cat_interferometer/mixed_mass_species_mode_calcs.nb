Cell[BoxData[
 RowBox[{
  RowBox[{"getModeParams", "[", 
   RowBox[{
   "U_", ",", " ", "massArr_", ",", " ", "ionEquilibriumPositions_", ",", " ",
     "numIons_", ",", "ionPositions_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\n", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "evals", ",", " ", "evecs", ",", "\n", "M", ",", " ", "H", ",", " ", 
      "orderingIndices", ",", " ", "evecsSorted", ",", " ", "\n", 
      "evecsNormalized", ",", " ", "evalsSorted", ",", " ", "secFreqsMHz", ",",
       " ", "hessianMassWeighted"}], "}"}], ",", "\n", "\n", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"construct", " ", "Hessian"}], " ", "-", " ", 
      RowBox[{
      "matrix", " ", "of", " ", "second", " ", "derivative", " ", "of", " ", 
       "potential", " ", 
       RowBox[{"w", ".", "r", ".", "t"}], " ", "ion", " ", "positions"}]}], 
     "*)"}], "\n", 
    RowBox[{
     RowBox[{"H", " ", "=", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"U", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Flatten", "[", "ionPositions", "]"}], ",", " ", "2"}], 
          "}"}]}], "]"}], "/.", "ionEquilibriumPositions"}]}], ";", "\n", 
     "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "create", " ", "mass", " ", "array", " ", "in", " ", "and", " ", 
        "move", " ", "to", " ", "mass"}], "-", 
       RowBox[{"weight", " ", "coordinates"}]}], "*)"}], "\n", 
     RowBox[{"M", " ", "=", " ", 
      RowBox[{"DiagonalMatrix", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"massArr", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", "amu", "*", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "numIons"}], "}"}]}], "]"}], "]"}], "]"}]}],
      ";", "\n", 
     RowBox[{"hessianMassWeighted", " ", "=", " ", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"Inverse", "[", "M", "]"}], "]"}], ".", "H", ".", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Inverse", "[", "M", "]"}], "]"}]}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"diagonalize", " ", "mass"}], "-", 
       RowBox[{
       "weighted", " ", "hessian", " ", "to", " ", "solve", " ", "for", " ", 
        "eigenvectors", " ", 
        RowBox[{"(", 
         RowBox[{"mode", " ", "parameters"}], ")"}], " ", "and", " ", 
        "eigenfrequencies"}]}], "*)"}], "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"evals", ",", " ", "evecs"}], "}"}], " ", "=", " ", 
      RowBox[{"Eigensystem", "[", "hessianMassWeighted", "]"}]}], ";", "\n", 
     RowBox[{"orderingIndices", " ", "=", " ", 
      RowBox[{"Ordering", "[", "evals", "]"}]}], ";", "\n", 
     RowBox[{"evecsSorted", " ", "=", " ", 
      RowBox[{"evecs", "[", 
       RowBox[{"[", "orderingIndices", "]"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Normalize", " ", "eigenvectors"}], " ", "-", " ", 
        RowBox[{
        "chop", " ", "turns", " ", "numbers", " ", "close", " ", "to", " ", 
         "0", " ", "to", " ", "0"}]}], ",", " ", 
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "eliminates"}], " ", "weird", " ", 
        "floating", " ", "points", " ", "remanants"}]}], "*)"}], "\n", 
     RowBox[{"evecsNormalized", " ", "=", " ", 
      RowBox[{"Chop", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Normalize", "[", 
          RowBox[{"evecsSorted", "[", 
           RowBox[{"[", "idx", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"idx", ",", " ", 
           RowBox[{"Length", "[", "evecsSorted", "]"}]}], "}"}]}], "]"}], 
       "]"}]}], ";", "\n", 
     RowBox[{"evalsSorted", " ", "=", " ", 
      RowBox[{"evals", "[", 
       RowBox[{"[", "orderingIndices", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"secFreqsMHz", " ", "=", " ", 
      RowBox[{"Chop", "[", 
       FractionBox[
        RowBox[{"Sqrt", "[", "evalsSorted", "]"}], 
        RowBox[{"2", "*", "\[Pi]", "*", "MHz"}]], "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"return", " ", "results"}], "*)"}], "\n", 
     RowBox[{"{", 
      RowBox[{"evecsNormalized", ",", " ", "secFreqsMHz"}], "}"}]}]}], "\n", 
   "]"}]}]], "Code",
