       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"azMassIndep", " ", "=", " ", 
      RowBox[{"massIndepMathieuParams", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"qxMassIndep", " ", "=", " ", 
      RowBox[{"massIndepMathieuParams", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"independentAxialFreqs", " ", "=", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        FractionBox["azMassIndep", "massArr"], "*", 
        FractionBox[
         SuperscriptBox["\[CapitalOmega]RF", "2"], "4"]}], "]"}]}], ";", "\n", 
     RowBox[{"independentEGGsFreqs", " ", "=", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["qxMassIndep", "massArr"], ")"}], "2"], "+", 
          RowBox[{"(", 
           RowBox[{
            FractionBox["arMassIndep", "massArr"], "-", 
            RowBox[{"2", "*", 
             FractionBox["azMassIndep", "massArr"]}]}], ")"}]}], ")"}], "*", 
        FractionBox[
         SuperscriptBox["\[CapitalOmega]RF", "2"], "8"]}], "]"}]}], ";", "\n", 
     RowBox[{"independentRFFreqs", "=", " ", 
