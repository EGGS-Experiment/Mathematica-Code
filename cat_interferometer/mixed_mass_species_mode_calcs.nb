        RowBox[{"2", "*", "qe", "*", "\[Kappa]"}], 
        RowBox[{"m1", "*", "amu"}]], "]"}], "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "+", "\[Mu]", "-", 
        RowBox[{"Sqrt", "[", 
