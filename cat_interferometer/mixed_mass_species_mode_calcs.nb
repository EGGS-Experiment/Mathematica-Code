          RowBox[{"9", ",", " ", "1"}], "]"}]}]}], ",", " ", "1", ",", "0"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", " ", "0", ",", "nMax"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Labeled", "[", 
