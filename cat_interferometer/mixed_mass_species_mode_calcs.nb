Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "convert", " ", "the", " ", "mathieu", " ", "parameters", " ", "to", " ", 
    "be", " ", "independent", " ", "of", " ", "mass"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"getMassIndepSecFreqs", "[", 
    RowBox[{
    "massIndepMathieuParams_", ",", " ", "massArr_", ",", " ", 
     "\[CapitalOmega]RF_"}], "]"}], ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "arMassIndep", ",", " ", "azMassIndep", ",", " ", "qxMassIndep", ",", 
       "\n", "independentAxialFreqs", ",", " ", "independentEGGsFreqs", ",", 
       " ", "independentRFFreqs"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"arMassIndep", " ", "=", " ", 
       RowBox[{"massIndepMathieuParams", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"azMassIndep", " ", "=", " ", 
       RowBox[{"massIndepMathieuParams", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"qxMassIndep", " ", "=", " ", 
       RowBox[{"massIndepMathieuParams", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"independentAxialFreqs", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         FractionBox["azMassIndep", "massArr"], "*", 
         FractionBox[
          SuperscriptBox["\[CapitalOmega]RF", "2"], "4"]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"independentEGGsFreqs", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["qxMassIndep", "massArr"], ")"}], "2"], "+", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["arMassIndep", "massArr"], "-", 
             RowBox[{"2", "*", 
              FractionBox["azMassIndep", "massArr"]}]}], ")"}]}], ")"}], "*", 
         FractionBox[
          SuperscriptBox["\[CapitalOmega]RF", "2"], "8"]}], "]"}]}], ";", 
      "\n", 
      RowBox[{"independentRFFreqs", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["independentEGGsFreqs", "2"], "-", 
         RowBox[{
          FractionBox[
           SuperscriptBox["\[CapitalOmega]RF", "2"], "2"], "*", 
          FractionBox["arMassIndep", "massArr"]}]}], "]"}]}], ";", "\n", 
      RowBox[{"{", 
       RowBox[{
       "independentAxialFreqs", ",", " ", "independentRFFreqs", ",", " ", 
        "independentEGGsFreqs"}], "}"}]}]}], "]"}]}]}]], "Code",
