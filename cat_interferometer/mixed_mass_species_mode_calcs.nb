Cell[BoxData[
 RowBox[{
  RowBox[{"getPotential", "[", 
   RowBox[{
   "massArr_", ",", " ", "massIndepSecFreqs_", ",", " ", "numIons_", ",", " ",
     "EField_", ",", " ", "ionPositions_", ",", " ", 
    RowBox[{"\[Beta]_", ":", "0"}], ",", " ", 
    RowBox[{"\[Gamma]_", ":", "0"}], ",", " ", 
    RowBox[{"\[Delta]_", ":", "0"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\n", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "independentAxialFreqs", ",", " ", "independentEGGsFreqs", ",", 
      "independentRFFreqs", ",", "\n", "Utrap", ",", " ", "UColoumb", ",", 
      " ", "UField", ",", " ", "Udipole", ",", " ", "Uanharmonic", ",", " ", 
      "U", ",", " ", "EFieldMat", ",", "\n", "Ucubic", ",", " ", "Uquartic", ",",
       " ", "Uquintic"}], "}"}], ",", "\n", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"EFieldMat", " ", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"EField", ",", " ", "numIons"}], "]"}]}], ";", "\n", 
      RowBox[{"independentAxialFreqs", " ", "=", " ", 
       RowBox[{"massIndepSecFreqs", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"independentRFFreqs", " ", "=", " ", 
       RowBox[{"massIndepSecFreqs", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"independentEGGsFreqs", " ", "=", " ", 
       RowBox[{"massIndepSecFreqs", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{"construct", " ", "harmonic", " ", "trap", " ", "potential"}], 
       "*)"}], "\n", 
      RowBox[{"Utrap", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"massArr", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "2"], "*", "amu", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"independentRFFreqs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "2"], "*", 
             SuperscriptBox[
              RowBox[{"x", "[", "i", "]"}], "2"]}], "+", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"independentEGGsFreqs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "2"], "*", 
             SuperscriptBox[
              RowBox[{"y", "[", "i", "]"}], "2"]}], "+", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"independentAxialFreqs", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "2"], "*", 
             SuperscriptBox[
              RowBox[{"z", "[", "i", "]"}], "2"]}]}], ")"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], "]"}]}],
       ";", "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"construct", " ", "ion"}], "-", 
        RowBox[{"ion", " ", "electrical", " ", "repulsion"}], " ", "-", " ", 
        RowBox[{
        "assume", " ", "all", " ", "ions", " ", "are", " ", "singly", " ", 
         "charged"}]}], "*)"}], "\n", 
      RowBox[{"UColoumb", " ", "=", " ", 
       RowBox[{
        FractionBox[
         SuperscriptBox["qe", "2"], 
         RowBox[{"4", "*", "\[Pi]", "*", "e0"}]], "*", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"Sum", "[", " ", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"x", "[", "i", "]"}], "-", 
                  RowBox[{"x", "[", "j", "]"}]}], ")"}], "2"], "+", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"y", "[", "i", "]"}], "-", 
                  RowBox[{"y", "[", "j", "]"}]}], ")"}], "2"], "+", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"z", "[", "i", "]"}], "-", 
                  RowBox[{"z", "[", "j", "]"}]}], ")"}], "2"]}], "]"}]], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", " ", 
              RowBox[{"j", "-", "1"}]}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], 
         "]"}]}]}], ";", "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "construct", " ", "potential", " ", "from", " ", "uniform", " ", 
         "field"}], " ", "-", " ", 
        RowBox[{
        "assume", " ", "all", " ", "ions", " ", "are", " ", "singly", " ", 
         "charged"}]}], "*)"}], "\n", 
      RowBox[{"UField", " ", "=", " ", 
       RowBox[{
        RowBox[{"-", "qe"}], "*", 
        RowBox[{"Total", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"ionPositions", "*", "EFieldMat"}], "]"}], "]"}]}]}], ";", 
      "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{
       "Construct", " ", "anharmonic", " ", "terms", " ", "up", " ", "to", " ",
         "5", "th", " ", "order"}], "*)"}], "\n", 
      RowBox[{"Ucubic", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"qe", "*", "\[Beta]", "*", 
          SuperscriptBox[
           RowBox[{"z", "[", "i", "]"}], "3"]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], "]"}]}],
       ";", "\n", 
      RowBox[{"Uquartic", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"qe", "*", "\[Gamma]", "*", 
          SuperscriptBox[
           RowBox[{"z", "[", "i", "]"}], "4"]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], "]"}]}],
       ";", "\n", 
      RowBox[{"Uquintic", " ", "=", " ", 
       RowBox[{"+", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"qe", "*", "\[Delta]", "*", 
           SuperscriptBox[
            RowBox[{"z", "[", "i", "]"}], "5"]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", "numIons"}], "}"}]}], 
         "]"}]}]}], ";", "\n", 
      RowBox[{"Uanharmonic", " ", "=", " ", 
       RowBox[{
       "Ucubic", " ", "+", " ", "Uquartic", " ", "+", " ", "Uquintic"}]}], 
      ";"}], " ", "\n", "\n", 
