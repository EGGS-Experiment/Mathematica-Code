Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testSecFreqs", " ", "=", " ", 
   RowBox[{"2", "*", "\[Pi]", "*", 
    RowBox[{"{", 
     RowBox[{".71", ",", " ", "1.5", ",", " ", "1.8"}], "}"}], "*", "MHz"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"secFreqs", " ", "=", " ", 
