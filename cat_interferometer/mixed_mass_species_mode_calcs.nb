        " ", "28", ",", " ", 
       RowBox[{"-", "179"}], ",", " ", "20"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resetSecFreqHz", " ", "=", " ", 
     RowBox[{"offsetSecFreqHz", " ", "-", " ", 
      RowBox[{"Max", "[", "offsetSecFreqHz", "]"}]}]}], ";"}], "\n", "\n", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Collect", " ", "and", " ", "process", " ", "data"}], "*)"}], "\n", 
