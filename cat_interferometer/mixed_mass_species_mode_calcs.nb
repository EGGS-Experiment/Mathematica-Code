Cell[CellGroupData[{

Cell["Axial OOP mode shift of Ca - HCl chain (see 09/10 data)", "Subsection",
 CellChangeTimes->{{4.0001392402856045`*^9, 
  4.0001392531473885`*^9}},ExpressionUUID->"f586d11d-043c-5c47-bcca-\
c01c75c87172"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"known", " ", "single", " ", "Ca", " ", "frequencies"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"knownSecFreqs", " ", "=", " ", 
     RowBox[{"2", "*", "\[Pi]", "*", "MHz", "*", 
      RowBox[{"{", 
       RowBox[{".7116", ",", " ", "1.706", ",", " ", "1.932"}], "}"}]}]}], 
    ";"}], " ", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{"masses", " ", "in", " ", "ion", " ", "chain"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"massArr", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"mH2Cl37", ",", "mCaIon"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numIons", " ", "=", " ", 
     RowBox[{"Length", "[", "massArr", "]"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"ionPositions", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", "i", "]"}], ",", " ", 
         RowBox[{"y", "[", "i", "]"}], ",", " ", 
         RowBox[{"z", "[", "i", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "numIons"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Collect", " ", "and", " ", "process", " ", "data"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"voltRange", " ", "=", " ", "20"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"voltMidPoint", " ", "=", " ", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"voltageList", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", 
       RowBox[{
        FractionBox["voltRange", "2"], "+", "voltMidPoint"}]}], "]"}]}], 
    ";"}], " ", "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "magic", " ", "number", " ", "from", " ", "what", " ", "I", " ", 
      "understand"}], " ", "-", " ", 
     RowBox[{
     "close", " ", "to", " ", "guggenmos", " ", "thesis", " ", "I", " ", 
      "think"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Kappa]Projection", " ", "=", " ", "1.8"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"simVoltageList", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{"Voltage", ",", "  ", 
       RowBox[{"{", 
        RowBox[{"Voltage", ",", " ", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "voltRange"}], "2"], "+", "voltMidPoint"}], ",", " ", 
         RowBox[{
          FractionBox["voltRange", "2"], "+", "voltMidPoint"}], ",", "0.1"}], 
        "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxSecFreq", " ", "=", " ", 
     RowBox[{"Max", "[", "secFreqs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"getSecFreqs", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", " ", "massArr", ",", 
        " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ", "numIons", ",", 
        " ", "ionPositions"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"secFreqs", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"getSecFreqs", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", 
                RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
             FractionBox[
              RowBox[{"\[Kappa]Projection", "*", 
               RowBox[{"(", 
                RowBox[{"Volt", "-", "voltMidPoint"}], ")"}]}], 
              RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", " ", 
           "massArr", ",", " ", "knownSecFreqs", ",", " ", "mCaIon", ",", " ",
            "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"Volt", ",", " ", "voltageList"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", "\n", 
   RowBox[{"AxialOOPStrayFieldPlot", " ", "=", " ", 
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"{", "\n", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"getSecFreqs", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  FractionBox[
                   RowBox[{"\[Kappa]Projection", "*", 
                    RowBox[{"(", 
                    RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                   RowBox[{"Sqrt", "[", "2", "]"}]], ",", 
                  FractionBox[
                   RowBox[{"\[Kappa]Projection", "*", 
                    RowBox[{"(", 
                    RowBox[{"Voltage", "-", "voltMidPoint"}], ")"}]}], 
                   RowBox[{"Sqrt", "[", "2", "]"}]], ",", "0"}], "}"}], ",", 
                " ", "massArr", ",", " ", "knownSecFreqs", ",", " ", "mCaIon",
                 ",", " ", "numIons", ",", " ", "ionPositions"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], "-", " ", 
            RowBox[{"Max", "[", "secFreqs", "]"}]}], ")"}], "*", "MHz"}], ",",
          "\n", 
         RowBox[{"{", 
          RowBox[{"Voltage", ",", " ", 
           RowBox[{"Min", "[", "voltageList", "]"}], ",", " ", 
           RowBox[{"Max", "[", "voltageList", "]"}]}], "}"}], ",", " ", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Black", ",", " ", 
            RowBox[{"Thickness", "->", "0.01"}]}], "}"}]}]}], "]"}], "}"}], ",",
       "\n", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Shim Voltage\>\"", ",", " ", "16"}], "]"}], ",", " ", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Axial OOP Shift (Hz)\>\"", ",", " ", "16"}], "]"}]}], 
        "}"}]}], ",", " ", 
      RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
      RowBox[{"Frame", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"True", ",", " ", "False"}], "}"}]}], "}"}]}], ",", "\n", 
      RowBox[{"GridLines", "->", "Automatic"}]}], "\n", "]"}]}]}]}]], "Code",
 CellChangeTimes->{{4.000139256915758*^9, 4.0001393489940624`*^9}, {
   4.0001393809692326`*^9, 4.0001394523708115`*^9}, {4.0001394840831776`*^9, 
   4.000139587381033*^9}, {4.000139635652113*^9, 4.000139987353037*^9}, 
   4.000140230813034*^9},ExpressionUUID->"0b2071fc-6fe0-564c-9ef2-\
4f080b672972"],

