      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "+", "\[Mu]", "+", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          SuperscriptBox["\[Mu]", "2"], "-", "\[Mu]", "+", "1"}], "]"}]}], 
       "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["3", 
