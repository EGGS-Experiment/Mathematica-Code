    RowBox[{"{", 
     RowBox[{".71", ",", " ", "2.2", ",", " ", "2.4"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"numIons", " ", "=", " ", 
   RowBox[{"Length", "[", "massArr", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ionPositions", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "i", "]"}], ",", " ", 
       RowBox[{"y", "[", "i", "]"}], ",", " ", 
       RowBox[{"z", "[", "i", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
