      RowBox[{"massIndepSecFreqs", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Utrap", " ", "=", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"massArr", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "2"], "*", "amu", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"independentRFFreqs", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "2"], "*", 
            SuperscriptBox[
             RowBox[{"x", "[", "i", "]"}], "2"]}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"independentEGGsFreqs", "[", 
