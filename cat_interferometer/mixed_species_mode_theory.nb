   RowBox[{"ImageSize", "->", "Large"}], ",", " ", 
   RowBox[{"TicksStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"\"\<Label\>\"", ",", " ", "16"}], "]"}]}]}], "]"}], "\n", 
 RowBox[{"MixedModesSec", " ", "=", " ", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      FractionBox[
       RowBox[{"\[Eta]1", "[", 
        RowBox[{"\[Mu]", ",", " ", "\[Omega]z"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"2", "*", "\[Pi]", "*", "kHz"}], ")"}]], ",", " ", 
      FractionBox[
       RowBox[{"\[Eta]3", "[", 
        RowBox[{"\[Mu]", ",", " ", "\[Omega]z"}], "]"}], 
